# Copy to .env and fill in values before running in production

# Required
KONET_JWT_SECRET=change-me-to-a-random-min-32-char-string
SECRET_KEY_BASE=change-me-to-a-64-char-random-string-for-cookie-signing

# Optional — set these after running: konet keys generate
KONET_ANON_KEY=
KONET_SERVICE_KEY=

# Required by docker-compose.yml — the password for /studio. Unset (when running
# the image without the compose file) = the Studio has no login: the server
# warns at boot, and the Keys page hides the keys and refuses rotation.
KONET_STUDIO_PASSWORD=

# Where a secret rotated from the Studio is persisted and read back at boot.
# docker-compose.yml defaults it to /data/jwt_secret on the konet-data volume.
# Unset = rotation lives in memory only and a restart reverts it.
KONET_SECRET_FILE=

# Server binding
KONET_HOST=localhost
KONET_PORT=4000

# WebSocket origin check: "*" (default) accepts any origin; otherwise a
# comma-separated list, e.g. https://app.example.com,https://admin.example.com
KONET_ALLOWED_ORIGINS=*

# Rate limits
KONET_RATE_LIMIT=60           # broadcasts per second per socket
KONET_CONN_RATE_LIMIT=200     # new connections per minute per IP
KONET_RATE_LIMIT_BINARY=120   # binary frames per second per socket (50/s = 20ms audio)

# Floor control: how long one member may hold the right to send before the
# server sweeps it, in milliseconds.
KONET_FLOOR_MAX_HOLD_MS=30000

# Members of one multiplex topic. Every one of them may send, and the server
# relays n × (n − 1) streams, so the ceiling bounds what one topic can cost.
# A joiner beyond it is refused with "topic_full". 0 removes the ceiling.
KONET_MULTIPLEX_MAX_MEMBERS=16

# Set to true only when a reverse proxy terminates TLS in front. It makes the
# per-IP connection limit read X-Forwarded-For; without it, every connection
# behind a proxy shares one budget and the deployment rate-limits itself. With
# it and no proxy, a client could forge the header to get a private budget.
KONET_TRUST_PROXY_HEADERS=false

# Logging every accepted broadcast makes one GenServer the serialization point
# for the whole server. false keeps the low-rate join/leave and floor entries.
KONET_LOG_BROADCASTS=true

# Replay buffer: last N broadcasts per room, pushed to late joiners as a
# "konet:history" event. 0 (default) disables it.
KONET_HISTORY_LIMIT=0

# How long a room's buffer outlives its last message, in seconds. Bounds the
# table for workloads that mint many short-lived room names; the buffer must
# outlive the room emptying, since that is exactly what a late joiner came for.
KONET_HISTORY_TTL=900

# Webhooks: POST channel_occupied/vacated + member_joined/left events to this
# URL. If a secret is set, requests carry an x-konet-signature HMAC header.
KONET_WEBHOOK_URL=
KONET_WEBHOOK_SECRET=
# Total attempts per event (1 disables retrying).
KONET_WEBHOOK_RETRIES=3
# Deliveries in flight at once; beyond it an event is dropped and logged.
KONET_WEBHOOK_CONCURRENCY=50
